rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 世界ランキング(1プレイヤー=1ドキュメント)。ghostはベスト時のリプレイ(世界1位ゴースト用)
    match /scores/{playerId} {
      allow read: if true;
      allow write: if request.resource.data.score is int
                   && request.resource.data.score >= 0
                   && request.resource.data.score <= 400
                   && request.resource.data.name is string
                   && request.resource.data.name.size() <= 12
                   && (!('ghost' in request.resource.data)
                       || (request.resource.data.ghost is string && request.resource.data.ghost.size() <= 8000));
      allow delete: if false;
    }

    // ともだちルーム: rooms/{コード}/members/{playerId}。コードを知る人だけが名簿を読める
    // (rooms直下の一覧は許可しない)。抜ける時は自分の名簿を消す
    match /rooms/{roomId}/members/{playerId} {
      allow read: if true;
      allow create, update: if roomId.size() == 6
                            && request.resource.data.score is int
                            && request.resource.data.score >= 0
                            && request.resource.data.score <= 400
                            && request.resource.data.name is string
                            && request.resource.data.name.size() <= 12;
      allow delete: if true;
    }
  }
}
